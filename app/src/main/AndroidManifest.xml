        <activity
            android:name=".FeedbackActivity"
            android:exported="true" />
        <activity
            android:name=".InventoryActivity"
            android:exported="true" />
        <activity
            android:name=".LoginActivity"
            android:exported="true" />
        <activity
            android:name=".ManagerActivity"
            android:exported="true" />
        <activity
            android:name=".ManagerDashboardActivity"
            android:exported="true" />
        <activity
            android:name=".ManagerInventoryActivity"
            android:exported="true" />
        <activity
            android:name=".ManagerMenuActivity"
            android:exported="true" />
        <activity
            android:name=".ManagerOrdersActivity"
            android:exported="true" />
        <activity
            android:name=".ManagerReservationsActivity"
            android:exported="true" />
        <activity
            android:name=".ManagerRoleActivity"
            android:exported="true" />
        <activity
            android:name=".MenuActivity"
            android:exported="true" />
        <activity
            android:name=".OrderActivity"
            android:exported="true" />
        <activity
            android:name=".RegisterActivity"
            android:exported="true" />
        <activity
            android:name=".ReservationActivity"
            android:exported="true" />
        <activity
            android:name=".ReserveTableActivity"
            android:exported="true" />
        <activity
            android:name=".SalesReportActivity"
            android:exported="true" />

