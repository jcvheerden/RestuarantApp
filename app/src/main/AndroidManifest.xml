<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.tastehaven_application">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TasteHaven_Application"
        tools:targetApi="31">

        <!-- MainActivity - Entry point of the app -->
        <activity
            android:name=".ManagerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AdminDashboardActivity"
            android:exported="true" />
        <activity
            android:name=".AddMenuItemActivity"
            android:exported="true" />

        <activity
            android:name=".AddInventoryItemActivity"
            android:exported="true" />
        <activity
            android:name=".EditMenuItemActivity"
            android:exported="true" />
        <activity
            android:name=".InventoryManagementActivity"
            android:exported="true" />

        <activity
            android:name=".ManagerInventory"
            android:exported="true" />
        <activity
            android:name=".ManagerReservation"
            android:exported="true" />
        <activity
            android:name=".ManagerStaff"
            android:exported="true" />
        <activity
            android:name=".MenuActivity"
            android:exported="true" />
        <activity
            android:name=".RemoveMenuItemActivity"
            android:exported="true" />
        <activity
            android:name=".ReservationCancel"
            android:exported="true" />
        <activity
            android:name=".ReservationManagementActivity"
            android:exported="true" />
        <activity
            android:name=".ReservationView"
            android:exported="true" />
        <activity
            android:name=".RoleManagementActivity"
            android:exported="true" />
        <activity
            android:name=".SalesReportActivity"
            android:exported="true" />
        <activity
            android:name=".UpdateInventoryItemActivity"
            android:exported="true" />
        <activity
            android:name=".UpdateReservationActivity"
            android:exported="true" />
        <activity
            android:name=".ViewInventoryActivity"
            android:exported="true" />

        <!-- Add more activities here if needed -->

    </application>

</manifest>
