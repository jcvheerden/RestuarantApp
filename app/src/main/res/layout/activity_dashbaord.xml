<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#FAFAFA"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Manager Dashboard"
            android:textSize="26sp"
            android:textColor="#00796B"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/viewOrdersButton"
            android:text="View Orders"
            android:backgroundTint="#009688"
            android:textColor="#fff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/viewReservationsButton"
            android:text="View Reservations"
            android:backgroundTint="#00796B"
            android:textColor="#fff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/viewInventoryButton"
            android:text="View Inventory"
            android:backgroundTint="#388E3C"
            android:textColor="#fff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <TextView
            android:text="Quick Overview"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#555"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <ListView
            android:id="@+id/dashboardListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="#CCC"
            android:dividerHeight="1dp"/>
    </LinearLayout>
</ScrollView>
