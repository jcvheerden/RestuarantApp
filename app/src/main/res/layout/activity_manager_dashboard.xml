<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#FFEB3B"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="Manager Dashboard"
        android:textSize="28sp"
        android:textColor="#1976D2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:layout_gravity="center"/>

    <!-- View Orders Button -->
    <Button
        android:id="@+id/viewOrdersButton"
        android:text="View Orders"
        android:textColor="#fff"
        android:background="#1976D2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center"/>

    <!-- View Reservations Button -->
    <Button
        android:id="@+id/viewReservationsButton"
        android:text="View Reservations"
        android:textColor="#fff"
        android:background="#1976D2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center"/>

    <!-- View Inventory Button -->
    <Button
        android:id="@+id/viewInventoryButton"
        android:text="View Inventory"
        android:textColor="#fff"
        android:background="#1976D2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center"/>

    <!-- Manage Menu Button -->
    <Button
        android:id="@+id/manageMenuButton"
        android:text="Manage Menu"
        android:textColor="#fff"
        android:background="#1976D2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center"/>

    <!-- View Sales Report Button -->
    <Button
        android:id="@+id/viewSalesReportButton"
        android:text="View Sales Report"
        android:textColor="#fff"
        android:background="#1976D2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center"/>

</LinearLayout>
