<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#FFEB3B"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="Manage User Roles"
        android:textSize="28sp"
        android:textColor="#1976D2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:layout_gravity="center"/>

    <EditText
        android:id="@+id/userIdInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter User ID"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/roleInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter New Role (e.g., waiter, manager)"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/updateRoleButton"
        android:text="Update Role"
        android:textColor="#fff"
        android:background="#1976D2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/removeUserButton"
        android:text="Remove User"
        android:textColor="#fff"
        android:background="#D32F2F"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
