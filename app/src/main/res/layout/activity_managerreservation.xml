<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <Button
        android:id="@+id/btnViewReservations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Reservations"
        android:background="#BB0038"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnUpdateReservation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update Reservation"
        android:background="#BB0038"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnCancelReservation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel Reservation"
        android:background="#BB0038"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />
</LinearLayout>
