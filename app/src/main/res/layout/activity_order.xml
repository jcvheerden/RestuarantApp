<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="20dp"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText android:id="@+id/tableNumberEditText" android:hint="Table Number" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <ListView android:id="@+id/menuListView" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/placeOrderButton" android:text="Place Order" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
