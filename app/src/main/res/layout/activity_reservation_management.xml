<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:orientation="vertical">

    <Button
        android:id="@+id/btnViewReservations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View All Reservations" />

    <Button
        android:id="@+id/btnUpdateReservation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update Reservation Status"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnCancelReservation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel Reservation"
        android:layout_marginTop="10dp" />
</LinearLayout>
