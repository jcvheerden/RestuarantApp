<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFEB3B">

    <TextView
        android:text="Sales Report"
        android:textSize="26sp"
        android:textColor="#1976D2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:layout_gravity="center"/>

    <TextView
        android:id="@+id/totalSalesTextView"
        android:text="Total Sales: $0.00"
        android:textSize="20sp"
        android:textColor="#1976D2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/totalOrdersTextView"
        android:text="Total Orders: 0"
        android:textSize="20sp"
        android:textColor="#1976D2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/completedOrdersTextView"
        android:text="Completed Orders: 0"
        android:textSize="20sp"
        android:textColor="#1976D2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/refreshButton"
        android:text="Refresh Report"
        android:textColor="#fff"
        android:background="#1976D2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center"
        android:onClick="fetchSalesData"/>
</LinearLayout>
